{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/brand-site/**",
              "ui_kits/internal-comms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chaney|Chaney Wide|Chaney Extended|Chaney Ultraextended|Silka|Baro Line Two|Baro Line One|Baro Plain))/i]",
        "message": "Font not provided by the design system. Available: Chaney, Chaney Wide, Chaney Extended, Chaney Ultraextended, Silka, Baro Line Two, Baro Line One, Baro Plain."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark|outline)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onDark|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onDark|disabled|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, onDark, disabled, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|bar|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, bar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|accent)$/]",
        "message": "<Card> tone must be one of 'light' | 'dark' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoBrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:partner|partnerMark|mode|height|endorsement|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<CoBrandLockup> doesn't accept that prop. Declared props: partner, partnerMark, mode, height, endorsement, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoBrandLockup'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:positive|negative|dark)$/]",
        "message": "<CoBrandLockup> mode must be one of 'positive' | 'negative' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edifications'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|height|align|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Edifications> doesn't accept that prop. Declared props: color, height, align, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edifications'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:black|red|white)$/]",
        "message": "<Edifications> color must be one of 'black' | 'red' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edifications'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Edifications> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|tone|outline|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: orientation, tone, outline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Eyebrow> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Isotype'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|assetBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Isotype> doesn't accept that prop. Declared props: color, size, assetBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Isotype'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|black|white)$/]",
        "message": "<Isotype> color must be one of 'red' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|color|height|clearSpace|assetBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: orientation, color, height, clearSpace, assetBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Logo> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|black|white)$/]",
        "message": "<Logo> color must be one of 'red' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|accent|dark)$/]",
        "message": "<Notice> tone must be one of 'info' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaginationDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|index|onSelect|onDark|key|ref|className|style|children)$/]",
        "message": "<PaginationDots> doesn't accept that prop. Declared props: count, index, onSelect, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, checked, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:weight|tone|width|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: weight, tone, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:hair|heavy|bar)$/]",
        "message": "<Rule> weight must be one of 'hair' | 'heavy' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|strong|accent)$/]",
        "message": "<Rule> tone must be one of 'default' | 'strong' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|tone|key|ref|className|style|children)$/]",
        "message": "<StatFigure> doesn't accept that prop. Declared props: value, label, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|ink|inverse)$/]",
        "message": "<StatFigure> tone must be one of 'accent' | 'ink' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|onDark|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, hint, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placement|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, placement, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
